# AI Configuration for D&D Character Consultant System
# Copy this file to .env and fill in your configuration.
#
# Convention: variables the system actually uses are listed as blank `KEY=`
# assignments (fill them in). Commented `# KEY=` entries are optional knobs that
# fall back to built-in defaults when unset. No values are hardcoded here.
#
# ALTERNATIVE: the centralized config system (game_data/config.json) can hold
# these instead - run the app and choose "Configure Settings". Env vars still
# work and take precedence where set.

# ============================================================================
# AI Models - Two-Model Setup (one creative, one fast)
# ============================================================================
# Tasks route to different models automatically:
#   Creative: story_generation, combat_narration  (high quality, slower)
#   Fast:     story_analysis, dc_evaluation, spotlight_analysis, embedding
#
# Ollama needs no real key - any non-empty value works (Drupal's AI module
# reads OLLAMA_API_KEY via the Key module's ollama_no_auth key).
OPENAI_API_KEY=
OLLAMA_API_KEY=
#
# Creative model (story writing, combat narration):
AI_CREATIVE_BASE_URL=
AI_CREATIVE_MODEL=
AI_CREATIVE_TEMPERATURE=
AI_CREATIVE_MAX_TOKENS=
#
# Fast model (analysis, RAG queries, evaluation):
AI_FAST_BASE_URL=
AI_FAST_MODEL=
AI_FAST_TEMPERATURE=
AI_FAST_MAX_TOKENS=
#
# Single-model fallback: if only one model is configured, all tasks use it.
# Set OPENAI_BASE_URL/OPENAI_MODEL instead of the AI_CREATIVE/AI_FAST pairs.
# OPENAI_BASE_URL=
# OPENAI_MODEL=
#
# Character-arc analysis knobs (optional; defaults shown for reference):
# ARC_AI_TIMEOUT=1800            # per-call timeout (s); local CPU is slow
# ARC_AGGREGATE_PROFILE=creative # 'creative' or 'fast' for the synthesis step
# ARC_SYNTHESIS_MAX_TOKENS=8000  # ceiling; must outlast a thinking model
# ARC_NARRATIVE_CHARS=16000      # total narrative budget across all stories

# ============================================================================
# Global AI Parameters (used when no per-profile override is set)
# ============================================================================
AI_TEMPERATURE=
AI_MAX_TOKENS=
AI_MAX_CONTEXT=
#
# AI call log (JSONL: ts, model, latency, tokens, messages, response).
# Optional; unset disables logging.
# AI_CALL_LOG_PATH=

# ============================================================================
# RAG (Retrieval-Augmented Generation)
# ============================================================================
# Wiki integration for lore-accurate generation. RAG_WIKI_BASE_URL is the
# campaign-setting wiki; RAG_RULES_BASE_URL is the D&D rules wiki (spell/ability
# lookups; MediaWiki and Wikidot layouts supported).
RAG_ENABLED=
RAG_WIKI_BASE_URL=
RAG_RULES_BASE_URL=
RAG_CACHE_TTL=
RAG_MAX_CACHE_SIZE=
RAG_SEARCH_DEPTH=
RAG_MIN_RELEVANCE=
# Comma-separated sourcebooks you own. Character creation only offers the
# backgrounds, species, and classes these books introduce; leave blank to offer
# everything the rules wiki publishes. Matching is a case-insensitive substring
# of the "Source:" line on each rules page, so a book line ("Eberron") selects
# every printing from it.
RAG_SOURCEBOOKS=
#
# RAG_CACHE_DIR=                 # optional local scratch dir

# ============================================================================
# Milvus Vector Database (semantic RAG retrieval)
# ============================================================================
# MILVUS_ENABLED=true swaps keyword search for semantic similarity. Requires
# Milvus running locally (see docker-compose.milvus.yml). MILVUS_HOST/PORT live
# in the "Local Service Startup" section below. MILVUS_EMBEDDING_MODEL must be
# reachable on an OpenAI-compatible endpoint; MILVUS_EMBEDDING_DIM must match
# its output dimension.
MILVUS_ENABLED=
MILVUS_COLLECTION_PREFIX=
MILVUS_EMBEDDING_MODEL=
MILVUS_EMBEDDING_DIM=
MILVUS_TOP_K=
MILVUS_SIMILARITY_THRESHOLD=

# ============================================================================
# Drupal CMS Integration
# ============================================================================
# DRUPAL_BASE_URL is the site URL (e.g. the DDEV site). DRUPAL_GRAPHQL_TOKEN is
# the bearer token Gatsby uses for authenticated reads (same value in Drupal's
# web container and Gatsby's build). DRUPAL_URL (start.sh section) mirrors it.
DRUPAL_BASE_URL=
DRUPAL_GRAPHQL_TOKEN=
DRUPAL_GRAPHQL_USER=
#
# Optional Drupal write/webhook settings:
# DRUPAL_USER=
# DRUPAL_PASSWORD=
# DRUPAL_GATSBY_WEBHOOK_URL=

# ============================================================================
# Search Query Parser Sidecar (run_sidecar.py)
# ============================================================================
# FastAPI microservice that normalises search queries before Milvus. Host/port
# live in the "Local Service Startup" section. SIDECAR_TIMEOUT/MIN_CONFIDENCE
# are also set in the DDEV web container so PHP can reach the host sidecar.
SIDECAR_TIMEOUT=
SIDECAR_MIN_CONFIDENCE=
#
# Optional sidecar server knobs:
# SIDECAR_LOG_LEVEL=info         # debug/info/warning/error
# SIDECAR_RELOAD=false           # dev hot-reload; never in prod
# SIDECAR_WORKERS=1              # uvicorn worker count
# SIDECAR_SECRET=                # shared secret; Drupal sends X-Sidecar-Secret
# SIDECAR_URL=                   # host sidecar URL, set in DDEV web container
# SIDECAR_JOB_TIMEOUT=           # seconds; per-call timeout for queued AI jobs,
#                                # set in the DDEV web container (minutes, not
#                                # seconds - a CPU render is slow)

# ============================================================================
# AI Job Queue (Drupal Advanced Queue -> host processor)
# ============================================================================
# Heavy AI (portraits, arc analysis, story generation, session summaries) runs
# as queued jobs drained by one host processor - one job at a time, which is
# what keeps two large models from being resident at once. start.sh launches it.
JOB_QUEUE_ENABLED=
# JOB_QUEUE_LOG_FILE=.jobqueue.log

# ============================================================================
# ComfyUI Portrait Generation (host service, never DDEV)
# ============================================================================
# Local Stable Diffusion image service for character portraits. Runs on the
# host like Ollama; the sidecar reaches it over its HTTP workflow API. Disabled
# by default - the Generate image button/endpoint no-ops until enabled. CPU-only
# generation is slow (minutes/image); prefer an SD 1.5-class checkpoint.
# COMFYUI_BASE_URL is derived from COMFYUI_HOST/COMFYUI_PORT when left empty. The
# sidecar unloads Ollama models before generation using OLLAMA_HOST/OLLAMA_PORT.
# When COMFYUI_ENABLED=true, start.sh launches ComfyUI from COMFYUI_DIR (its own
# venv) as a background host process; COMFYUI_EXTRA_ARGS passes launch flags.
COMFYUI_ENABLED=
COMFYUI_HOST=
COMFYUI_PORT=
COMFYUI_BASE_URL=
COMFYUI_TIMEOUT=
COMFYUI_CHECKPOINT=
COMFYUI_DIR=
# Ollama vision model for the image->prompt button (e.g. qwen2.5vl:3b, ~10s on
# CPU - the describe call caps num_ctx to keep the KV cache small). Named without
# a COMFYUI_ prefix so a deployment can point it at any model it runs.
IMAGE_TO_PROMPT_MODEL=
# COMFYUI_EXTRA_ARGS=            # e.g. --cpu --listen (optional launch flags)
#
# IPAdapter likeness consistency: file names inside ComfyUI's models/ipadapter/
# and models/clip_vision/ dirs. Set both to keep a regenerated portrait
# recognisably the same character; leave either blank and generation stays
# text-to-image. Requires the ComfyUI-IPAdapter-plus custom nodes. The pair must
# match COMFYUI_CHECKPOINT's model family - an IPAdapter built for one family
# produces nothing useful on another.
# Use a GENERAL IPAdapter, not a "-face" one. Face variants encode human facial
# identity and will convert a non-human character (dragonborn, tiefling) into
# the nearest human face while the costume and setting transfer correctly - so
# it looks like it worked. No negative prompt undoes it. See src/README.md.
COMFYUI_IPADAPTER_MODEL=
COMFYUI_CLIP_VISION=

# ============================================================================
# Local Service Startup (start.sh)
# ============================================================================
# Required service hosts/ports. start.sh treats these as authoritative and
# exits with an error if any is missing.
DRUPAL_URL=
GATSBY_HOST=
GATSBY_PORT=
SIDECAR_HOST=
SIDECAR_PORT=
# Interface uvicorn binds to. Bind every interface so the DDEV web container can
# reach the sidecar over its host gateway for queued AI jobs; host clients keep
# dialling SIDECAR_HOST. Defaults to SIDECAR_HOST when unset.
SIDECAR_BIND_HOST=
OLLAMA_HOST=
OLLAMA_PORT=
# How the DDEV web container reaches the host Ollama (Ollama runs on the host,
# not as a DDEV service). Normally the Docker host gateway name.
DDEV_OLLAMA_HOST=
MILVUS_HOST=
MILVUS_PORT=
#
# Optional operational knobs (start.sh has built-in defaults):
# GATSBY_DEFAULT_PORT=
# GATSBY_CLEAN_ON_START=true
# GATSBY_KILL_STALE_LISTENERS=true
# GATSBY_LOG_FILE=.gatsby.log
# SIDECAR_LOG_FILE=.sidecar.log
# COMFYUI_KILL_STALE_LISTENERS=true
# COMFYUI_LOG_FILE=.comfyui.log
# MKCERT_CA=                     # ddev mkcert rootCA.pem; defaults to
#                                # $HOME/.local/share/mkcert/rootCA.pem

# ============================================================================
# Per-Character Configuration (in each character's JSON file)
# ============================================================================

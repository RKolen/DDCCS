extend type Mutation {
  """
  Find-or-create a character's analysis node (keyed by campaign + character) and
  store either one story's analysis (storyNumber + storyText) or the synthesized
  summary. Persists each story as it completes so a long run is crash-safe.
  Returns the analysis node.
  """
  upsertCharacterAnalysis(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "UUID of the character node."
    characterId: ID!
    "Story number this analysis belongs to (with storyText)."
    storyNumber: Int
    "The story's analysis text (with storyNumber)."
    storyText: String
    "The story's structured data point as a JSON string (with storyNumber)."
    datapoint: String
    "The synthesized arc summary."
    summary: String
  ): NodeCharacterAnalysi

  """
  Delete a character's analysis node for a campaign (discard). Returns true when
  removed (or nothing existed), false when permission is denied.
  """
  deleteCharacterAnalysis(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "UUID of the character node."
    characterId: ID!
  ): Boolean

  """
  Create a new source character node from a derived character payload.
  The payload is the JSON-encoded character dictionary produced by the
  Python sidecar build-from-template endpoint. The new node is flagged as a
  source character (no campaign); attach a campaign clone via
  addCharacterToCampaign. Returns the created character node.
  """
  createCharacter(
    "JSON-encoded derived character dictionary."
    payload: String!
  ): NodeCharacter

  """
  Create a minimal NPC character node for a campaign: a name, one line on who
  they are, and where they came from. The counterpart to createCharacter,
  which derives a full player sheet and always creates a PC. Used when a
  campaign's session recaps name NPCs that have no node yet; everything else
  is filled in later through the character editor. Creating a name that
  already exists in the campaign returns the existing NPC rather than a
  duplicate.
  """
  createNpcStub(
    "UUID of the campaign term to scope the NPC to."
    campaignId: ID
    "The NPC's name."
    name: String!
    "One line on who they are."
    role: String
    "Where the NPC came from, e.g. which sessions named them."
    note: String
  ): NodeCharacter

  """
  Save character arc analysis results onto a character node. The payload is the
  JSON-encoded arc result (direction, stage, summary, storiesAnalyzed,
  updatedAt, metrics, relationships, goals) from the sidecar /character/arc
  endpoint. Replaces any existing arc data. Returns the updated character node.
  """
  saveCharacterArc(
    "UUID of the character node."
    id: ID!
    "JSON-encoded arc analysis result."
    payload: String!
  ): NodeCharacter

  """
  Attach a generated portrait image to a character node. The image is a
  base64-encoded PNG from the sidecar /character/portrait (ComfyUI) endpoint.
  Creates a file + image media entity and points the character's field_image at
  it, replacing any previous portrait reference. Returns the updated character
  node.
  """
  setCharacterPortrait(
    "UUID of the character node."
    id: ID!
    "Base64-encoded PNG image data."
    imageBase64: String!
    "Alt text for the image. Required by the media image field."
    alt: String!
  ): NodeCharacter

  """
  Point a character's portrait (field_image) at an existing image media entity,
  selected from the media library - for example a previously generated portrait.
  Does not create new media. Returns the updated character node.
  """
  setCharacterImage(
    "UUID of the character node."
    id: ID!
    "UUID of the existing image media to attach."
    mediaId: ID!
  ): NodeCharacter

  """
  Update a character node's voice settings. Only the supplied arguments are
  changed. Returns the updated character node.
  """
  updateCharacter(
    "UUID of the character node."
    id: ID!
    "Voice id — a voice_ids taxonomy term name (e.g. en_US-ryan-low)."
    voiceId: String
    "Voice pitch."
    voicePitch: Float
    "Voice speed."
    voiceSpeed: Float
    "Reusable image-generation prompt (field_image_prompt)."
    imagePrompt: String
  ): NodeCharacter

  """
  Write a character node's editable profile fields. The payload is a JSON
  object keyed by the console's camelCase field names; only the keys it
  contains are changed, so the editor can send a partial patch. Keys the
  mutation does not recognise are ignored.

  Portrait, voice, and arc-analysis fields are not writable here - they belong
  to setCharacterPortrait / setCharacterImage, updateCharacter, and
  saveCharacterArc respectively. Campaign membership and the player/NPC flag
  are not writable here either.

  Returns the updated character node.
  """
  updateCharacterProfile(
    "UUID of the character node."
    id: ID!
    "JSON-encoded map of profile fields to write."
    payload: String!
  ): NodeCharacter

  """
  Create a new campaign taxonomy term. Returns the created term on success,
  or null if creation fails validation.
  """
  createCampaign(
    "The campaign name."
    name: String!
    "Optional lifecycle status: active, completed, or on_hold."
    status: String
  ): TermCampaign

  """
  Store a session summary + synthesized overview on a campaign term. Upserts the
  session_summary paragraph by story number and replaces the campaign overview.
  Returns the updated campaign term.
  """
  setSessionSummary(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "Story number the summary belongs to."
    storyNumber: Int!
    "The session summary text."
    summary: String!
    "The synthesized campaign overview (optional)."
    overview: String
  ): TermCampaign

  """
  Add an existing character node to a campaign's current party.
  Returns the updated campaign term. No-op if already a member.
  """
  addCharacterToCampaign(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "UUID of the character node."
    characterId: ID!
  ): TermCampaign

  """
  Create a new story node linked to a campaign.
  Returns the created story node on success.
  """
  createStory(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "Story title."
    title: String!
    "Story body text (markdown)."
    body: String!
    "Story number within the campaign series."
    storyNumber: Int!
    "Session date in YYYY-MM-DD format. Defaults to today."
    sessionDate: String
  ): NodeStory

  """
  Create a story arc: the multi-story plan a run of stories is written
  against. Only the campaign and title are required, so the console's wizard
  can create the arc after its first step and fill the rest in as the user
  advances (via updateStoryArc).

  The payload is a JSON object keyed by the console's camelCase names; only
  the keys it contains are written. Recognised keys: body (the full premise),
  overallPlot, levelRange, targetStories, faction (a factions-vocabulary term
  UUID or exact name), party and npcs (lists of character node UUIDs or exact
  titles). References that do not resolve are skipped rather than failing the
  write, so a partially matched markdown import still saves what it matched.

  Relationships are not written here - see saveStoryArcRelations.
  Returns the created story arc node.
  """
  createStoryArc(
    "UUID of the campaign taxonomy term."
    campaignId: ID!
    "Arc title."
    title: String!
    "JSON-encoded map of arc fields. Omit to create a bare arc."
    payload: String
  ): NodeStoryArc

  """
  Write a story arc's editable fields from a partial JSON patch. Accepts the
  same keys as createStoryArc, plus title and campaign (a campaign term UUID
  or exact name). Only the keys present are changed.

  Relationships are not written here - see saveStoryArcRelations.
  Returns the updated story arc node.
  """
  updateStoryArc(
    "UUID of the story arc node."
    id: ID!
    "JSON-encoded map of arc fields to write."
    payload: String!
  ): NodeStoryArc

  """
  Replace a story arc's relationship collections. The payload is a JSON object
  holding a "party" list, an "npc" list, or both; each entry is
  {source, target, type, tier, note}, where source and target are character
  node UUIDs or exact titles and tier is 1 (direct and personal), 2
  (thematic), or 3 (incidental).

  Only the sides present are replaced, so the party and NPC suggestion runs can
  each save without clearing the other. Replacement within a side is wholesale:
  the console sends the set that survived accept/reject, not a diff. A pair
  whose source or target does not resolve is skipped.

  Returns the updated story arc node.
  """
  saveStoryArcRelations(
    "UUID of the story arc node."
    id: ID!
    "JSON-encoded map with a party and/or npc list of relations."
    payload: String!
  ): NodeStoryArc
}

"""
A cached wiki page, stored as a wiki_cache node and keyed by the MD5 hash of
its URL. Internal to the Python RAG system's DrupalWikiCache - deliberately
kept out of graphql_compose so Gatsby never sources these nodes.
"""
type WikiCacheEntry {
  "The original page URL."
  url: String!
  "Unix timestamp of when the page was fetched."
  fetchedAt: Float!
  "Serialized JSON of the page's parsed sections."
  content: String!
}

extend type Query {
  """
  Look up a cached wiki page by the MD5 hash of its URL. NULL when nothing is
  cached for that hash - callers treat that as a cache miss and re-fetch.
  """
  wikiCacheEntry(
    "MD5 hash of the page URL, used as the node title."
    urlHash: String!
  ): WikiCacheEntry

  """
  Total number of wiki cache entries, for cache statistics.
  """
  wikiCacheCount: Int!
}

extend type Mutation {
  """
  Create or replace the cached wiki page for a URL hash. Returns the stored
  entry.
  """
  setWikiCacheEntry(
    "MD5 hash of the page URL, used as the node title."
    urlHash: String!
    "The original page URL."
    url: String!
    "Unix timestamp of when the page was fetched."
    fetchedAt: Float!
    "Serialized JSON of the page's parsed sections."
    content: String!
  ): WikiCacheEntry

  """
  Delete the cached wiki page for a URL hash. Returns TRUE when an entry was
  removed or none existed, FALSE when permission was denied.
  """
  deleteWikiCacheEntry(
    "MD5 hash of the page URL, used as the node title."
    urlHash: String!
  ): Boolean!
}
